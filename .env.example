# Copy to .env and fill in for your host:  cp .env.example .env
# .env itself is gitignored — it holds host-specific values and, later, real secrets
# (Gluetun VPN credentials, API keys). Never commit it.

# Run containers as your user so files on disk aren't root-owned.
# Find yours with: id -u ; id -g
PUID=1000
PGID=1000

# Affects log timestamps, Jellyfin scheduled tasks, and the future n8n nightly digest.
TZ=Etc/UTC

# Tailnet IP of this host — used to bind admin UIs to Tailscale only, off the LAN.
# Find yours with: tailscale ip -4
TAILNET_IP=100.64.0.0

# gid of the host 'render' group — lets Jellyfin use Intel Quick Sync for hardware
# transcoding. Find yours with: getent group render
RENDER_GID=991

# qBittorrent WebUI admin login. The linuxserver image prints a temporary password to
# 'docker logs qbittorrent' on first start — log in with it, set a real one, record it
# here. Phase 2 (Sonarr/Radarr) needs these to connect to the download client.
QBIT_WEBUI_USER=admin
QBIT_WEBUI_PASS=changeme

# NordLynx (WireGuard) private key for Gluetun. Not visible in Nord's dashboard — fetch it
# from https://api.nordvpn.com/v1/users/services/credentials using a dashboard access token.
NORD_WG_PRIVATE_KEY=

# ---------------------------------------------------------------------------------
# Step 13 — n8n automation stack
# ---------------------------------------------------------------------------------

# Encrypts every credential n8n stores. MUST be stable across restarts — if it changes,
# all stored credentials become unrecoverable and Google OAuth must be redone.
# Generate with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Must match the redirect URI registered in Google Cloud exactly, port included.
N8N_HOST=your-host.tailnet-name.ts.net
N8N_PUBLIC_URL=https://your-host.tailnet-name.ts.net:8445/

# LLM endpoint. Local ollama by default; swap these three for a hosted API.
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
LLM_API_KEY=

# Notification delivery. Discord carries content, SMTP carries failure alerts —
# deliberately separate paths so a broken webhook can still report itself.
DISCORD_BRIEF_WEBHOOK=
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_EMAIL_TO=

# Canvas iCal feed. A BEARER CREDENTIAL — anyone holding the URL can read the whole
# calendar with no login. Canvas -> Calendar -> "Calendar Feed" at the bottom right.
CANVAS_ICS_URL=

# Dedicated Google Calendar for Canvas deadlines (c_xxxx@group.calendar.google.com).
GCAL_CANVAS_ID=

# Open-Meteo needs no API key; these are just coordinates.
WEATHER_LAT=
WEATHER_LON=

# n8n owner login (created via the web form at :8445 on first run). Lets scripts drive
# n8n's REST API — importing workflows, checking execution history — without clicking.
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=
